# Copy to `.env` and edit, or pass these inline:
#   ROS_DISTRO=humble docker compose up -d

# Which ROS 2 distro image to run: humble | jazzy | kilted | lyrical | rolling
ROS_DISTRO=jazzy

# Match the rest of your robot's ROS 2 stack.
ROS_DOMAIN_ID=0

# Port the connect listens on.
SCRY_PORT=5339

# Auth mode: open (trusted LAN, no token) or token.
SCRY_AUTH_MODE=open
# Required only when SCRY_AUTH_MODE=token.
SCRY_TOKEN=
