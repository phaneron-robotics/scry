# Tell GitHub Linguist what this repo "is" — an umbrella project (docs,
# install scripts, docker-compose), not a Python project. Without this,
# Linguist counts the small example sim publishers under robot-setup/sim/
# and labels the whole repo as Python, which is misleading.

# Robot-setup is install glue and tiny example publishers — not application
# code. Don't let it dominate the language stats.
robot-setup/sim/        linguist-vendored
robot-setup/sim/**      linguist-vendored

# Docker / Compose files are configuration, not application code.
robot-setup/Dockerfile* linguist-detectable=true
robot-setup/*.yml       linguist-detectable=true

# Markdown is documentation.
*.md                    linguist-documentation
