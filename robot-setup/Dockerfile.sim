# Scry sim image — full ROS 2 Jazzy desktop + Gazebo Harmonic + TurtleBot3
# stack for end-to-end testing of the Scry app against a moving robot with
# real sensor topics (lidar, camera, IMU, odometry, tf).
#
# What's inside:
#   - ROS 2 Jazzy desktop-full (rviz2, demo_nodes, common msgs, tf2 tools)
#   - Gazebo Harmonic + ros_gz connect
#   - TurtleBot3 packages (msgs, description, gazebo, teleop) built from source
#     (TurtleBot3 has no apt release for Jazzy yet — `jazzy` branch is used.)
#   - Nav2 (navigation2) and SLAM Toolbox + Cartographer
#   - rqt, rqt_image_view, teleop_twist_keyboard
#   - scry-connect dependencies pre-installed
#
# Image is large (~7 GB). Build once, then `up` is fast.
#
# Build:  docker compose -f docker-compose.sim.yml build
# Run:    docker compose -f docker-compose.sim.yml up
# Shell:  docker exec -it scry-sim bash

FROM osrf/ros:jazzy-desktop-full

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONUNBUFFERED=1 \
    ROS_DISTRO=jazzy \
    ROS_DOMAIN_ID=0 \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
    TURTLEBOT3_MODEL=burger \
    GZ_VERSION=harmonic \
    SCRY_PORT=5339 \
    SCRY_VENV=/opt/scry-venv \
    PATH=/opt/scry-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ── OSRF Gazebo apt repo ─────────────────────────────────────────
# Gazebo Harmonic is NOT in Ubuntu Noble's archive — it lives in OSRF's
# apt repo. We add it here so `gz-harmonic` (the meta-package that pulls
# in the simulator, GUI, plugins, sensors, etc.) is resolvable.
# ros-jazzy-ros-gz pairs with Harmonic on Jazzy by default.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        lsb-release \
 && curl -fsSL https://packages.osrfoundation.org/gazebo.gpg \
        -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/gazebo-stable.list \
 && rm -rf /var/lib/apt/lists/*

# ── apt packages ─────────────────────────────────────────────────
# Nav2 + SLAM Toolbox + Cartographer give us a full SLAM + navigation stack.
# ros-jazzy-ros-gz pulls in gz-harmonic as a dependency, but we list it
# explicitly so an upstream change in ros-gz doesn't silently drop it.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        wget \
        nano \
        python3-pip \
        python3-venv \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-vcstool \
        ros-jazzy-demo-nodes-cpp \
        ros-jazzy-demo-nodes-py \
        ros-jazzy-example-interfaces \
        ros-jazzy-rmw-cyclonedds-cpp \
        ros-jazzy-teleop-twist-keyboard \
        ros-jazzy-teleop-twist-joy \
        ros-jazzy-rqt \
        ros-jazzy-rqt-common-plugins \
        ros-jazzy-rqt-image-view \
        ros-jazzy-rqt-tf-tree \
        ros-jazzy-tf2-tools \
        ros-jazzy-xacro \
        ros-jazzy-joint-state-publisher \
        ros-jazzy-joint-state-publisher-gui \
        ros-jazzy-robot-state-publisher \
        ros-jazzy-cartographer \
        ros-jazzy-cartographer-ros \
        ros-jazzy-slam-toolbox \
        ros-jazzy-navigation2 \
        ros-jazzy-nav2-bringup \
        ros-jazzy-ros-gz \
        ros-jazzy-ros-gz-bridge \
        ros-jazzy-ros-gz-sim \
        ros-jazzy-ros-gz-image \
        ros-jazzy-gz-ros2-control \
        gz-harmonic \
        x11-apps \
        mesa-utils \
        libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*

# ── GPU acceleration stack (CuPy + CUDA runtime libs) ─────────────
# Enables scry-connect's hexagonal imaging port to pick the CuPy codec at
# startup. Without this layer the codec falls back to PIL (CPU) and the
# log reports `hardware=cuda` but `codec=pil`.
#
# Three pieces are needed and all three are missing from
# osrf/ros:jazzy-desktop-full:
#
#   1. cupy-cuda12x (Python). Installed into /usr/local/lib/python3.12/dist-
#      packages with --target so it shadows the debian numpy 1.26 with
#      numpy 2.x (cupy 14 requires numpy >= 2). This dist-packages dir is
#      earlier on the system Python's sys.path than the apt-installed
#      /usr/lib/python3/dist-packages, so the override is automatic.
#
#   2. scipy >= 1.13 (Python). CuPy's runtime lazily imports cupyx for
#      many otherwise-benign ops (cp.clip, cp.linspace, cp.floor, …).
#      cupyx in turn imports cupyx.scipy.sparse, which transitively
#      imports scipy.sparse. The debian-shipped scipy 1.11.4 is compiled
#      against numpy 1.x and crashes with `ImportError: A module that
#      was compiled using NumPy 1.x cannot be run in NumPy 2.x` once
#      numpy 2 is the active runtime. The crash propagates out of cupy's
#      lazy import inside per-frame encode and kills the SSE stream.
#      Installing a numpy-2-compatible scipy alongside makes the
#      cupyx import succeed cleanly.
#
#   3. CUDA toolkit runtime libs (libnvrtc, libcudart, libcublas). The
#      driver is injected at container start by `runtime: nvidia` but the
#      toolkit isn't. Without libnvrtc CuPy fails to JIT-compile kernels.
#      We install from NVIDIA's official apt repo and register the
#      install path with ldconfig so the dynamic linker finds the libs.
#
# This whole layer is a no-op on hosts without an NVIDIA GPU — the
# container can still start (the libs just sit on disk unused) and the
# runtime probe correctly reports `kind=cpu`. Skip at build time by
# passing `--build-arg SCRY_GPU=cpu`.
ARG SCRY_GPU=auto
RUN if [ "${SCRY_GPU}" != "cpu" ]; then \
        set -e ; \
        echo "=== Installing NVIDIA CUDA apt repo ===" ; \
        wget -q https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb ; \
        dpkg -i cuda-keyring_1.1-1_all.deb ; \
        rm cuda-keyring_1.1-1_all.deb ; \
        apt-get update -qq ; \
        echo "=== Installing CUDA runtime libs (NVRTC + CUDART + cuBLAS) ===" ; \
        apt-get install -y --no-install-recommends \
            cuda-nvrtc-12-6 \
            cuda-cudart-12-6 \
            libcublas-12-6 ; \
        rm -rf /var/lib/apt/lists/* ; \
        echo "/usr/local/cuda-12.6/targets/x86_64-linux/lib" > /etc/ld.so.conf.d/cuda-12.6.conf ; \
        ldconfig ; \
        echo "=== Installing cupy-cuda12x + numpy 2 + scipy 1.13+ (into /usr/local) ===" ; \
        /usr/bin/python3 -m pip install \
            --break-system-packages \
            --target=/usr/local/lib/python3.12/dist-packages \
            cupy-cuda12x "scipy>=1.13" ; \
        echo "=== Sanity check (import-only; GPU runtime not available during build) ===" ; \
        /usr/bin/python3 -c "import cupy; print('cupy', cupy.__version__, 'wheel OK')" ; \
        /usr/bin/python3 -c "import scipy; import scipy.sparse; print('scipy', scipy.__version__, 'sparse OK')" ; \
        /usr/bin/python3 -c "import cupy as cp; from cupyx.scipy.ndimage import zoom; print('cupyx imports OK')" ; \
    else \
        echo "SCRY_GPU=cpu, skipping GPU stack install"; \
    fi

# ── Python venv for scry-connect ──────────────────────────────────
# Ubuntu Noble (PEP 668) marks system Python as externally-managed and
# the apt-shipped pip 24 can't be upgraded in place. We create a venv with
# --system-site-packages so it inherits rclpy (apt-installed under
# /opt/ros/jazzy/lib/python3.12/site-packages once ROS is sourced) but
# keeps scry-connect's pip-installed deps in /opt/scry-venv. PATH is set
# above so `pip` and `scry-connect` resolve to the venv.
#
# Pillow + psutil aren't declared in scry-connect's pyproject.toml but the
# connect uses them (image resize, system_info). Everything else (mcp,
# uvicorn, starlette, sse-starlette, qrcode, zeroconf) gets pulled in by
# `pip install -e /opt/scry-connect` at runtime via compose.
RUN python3 -m venv --system-site-packages "${SCRY_VENV}" \
 && "${SCRY_VENV}/bin/pip" install --no-cache-dir --upgrade pip 'packaging>=24.2' \
 && "${SCRY_VENV}/bin/pip" install --no-cache-dir pillow psutil

# ── TurtleBot3 + frontier exploration from source ────────────────
# TurtleBot3 has no apt release for Jazzy yet — clone the jazzy branch.
# m-explore-ros2 (explore_lite) gives us frontier-based autonomous
# exploration: it watches /map from slam_toolbox, picks the nearest
# unexplored frontier, and pushes goals into Nav2's NavigateToPose
# action. With it we can boot the sim and watch the robot drive itself
# around, building the map without manual teleop.
ENV TB3_WS=/opt/turtlebot3_ws
RUN mkdir -p ${TB3_WS}/src && cd ${TB3_WS}/src \
 && git clone -b jazzy https://github.com/ROBOTIS-GIT/turtlebot3_msgs.git \
 && git clone -b jazzy https://github.com/ROBOTIS-GIT/turtlebot3.git \
 && (git clone -b jazzy https://github.com/ROBOTIS-GIT/turtlebot3_simulations.git \
     || git clone -b main https://github.com/ROBOTIS-GIT/turtlebot3_simulations.git) \
 && (git clone -b jazzy https://github.com/ROBOTIS-GIT/DynamixelSDK.git || true) \
 && (git clone -b jazzy https://github.com/robo-friends/m-explore-ros2.git \
     || git clone -b main https://github.com/robo-friends/m-explore-ros2.git)

# Build the workspace.
RUN cd ${TB3_WS} \
 && source /opt/ros/jazzy/setup.bash \
 && rosdep update --rosdistro=jazzy \
 && apt-get update \
 && rosdep install --from-paths src --ignore-src -r -y --rosdistro=jazzy || true \
 && colcon build --symlink-install --parallel-workers 2 \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
 && rm -rf /var/lib/apt/lists/* /root/.ros/log

# ── Auto-source ROS + workspace on every shell ───────────────────
RUN echo 'source /opt/ros/jazzy/setup.bash' >> /etc/bash.bashrc \
 && echo '[ -f /opt/turtlebot3_ws/install/setup.bash ] && source /opt/turtlebot3_ws/install/setup.bash' >> /etc/bash.bashrc \
 && echo 'export TURTLEBOT3_MODEL=${TURTLEBOT3_MODEL:-burger}' >> /etc/bash.bashrc \
 && cp /etc/bash.bashrc /root/.bashrc

# Helper scripts (mounted from host at runtime via compose, but also
# installed here so the image is self-contained).
COPY robot-setup/sim/ /opt/scry-sim/
RUN chmod +x /opt/scry-sim/*.sh

WORKDIR /opt/scry-connect

EXPOSE 5339

# Default: just drop into a shell. Compose overrides per service.
CMD ["bash", "-l"]
