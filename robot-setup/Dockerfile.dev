# Scry dev image — everything needed to test the connect locally.
#
# Based on `ros:humble-desktop` which bundles turtlesim, demo_nodes_cpp,
# rviz2, and most common message packages. We add pip + scry-connect
# deps on top.
#
# Build:   docker compose -f docker-compose.dev.yml build
# Run:     docker compose -f docker-compose.dev.yml up
# Shell:   docker exec -it scry-connect bash     (ROS auto-sourced)

FROM osrf/ros:humble-desktop-full

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_ROOT_USER_ACTION=ignore \
    SCRY_PORT=5339 \
    ROS_DOMAIN_ID=0 \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
    PYTHONUNBUFFERED=1

# ── System packages ──────────────────────────────────────────────
# demo-nodes-cpp/py — talker/listener/add_two_ints for smoke tests
# turtlesim — for GUI and interactive testing
# example-interfaces — message types used by the demos
# ros2-control / controller_manager-msgs — so the ros2_control tools have something to try against (optional)
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip \
        ros-humble-demo-nodes-cpp \
        ros-humble-demo-nodes-py \
        ros-humble-turtlesim \
        ros-humble-example-interfaces \
        ros-humble-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

# ── Python deps ──────────────────────────────────────────────────
RUN python3 -m pip install --no-cache-dir --upgrade 'pip>=24' 'packaging>=24.2' \
 && python3 -m pip install --no-cache-dir \
        'mcp>=1.0.0' \
        'uvicorn>=0.27.0' \
        'starlette>=0.36.0' \
        'sse-starlette>=1.8.0' \
        pillow \
        psutil

# ── Auto-source ROS on every shell ───────────────────────────────
# Interactive AND non-interactive shells get ROS sourced.
RUN echo 'source /opt/ros/humble/setup.bash' >> /etc/bash.bashrc \
 && echo 'source /opt/ros/humble/setup.bash' >> /root/.bashrc

# ── Connect source mount point ────────────────────────────────────
WORKDIR /opt/scry-connect

# The connect source is mounted at runtime by docker-compose;
# we install in editable mode via the compose command.

EXPOSE 5339

# Default command: just start the connect.
# docker-compose overrides this to install editable first.
CMD ["bash", "-lc", "scry-connect --host 0.0.0.0 --port ${SCRY_PORT}"]
